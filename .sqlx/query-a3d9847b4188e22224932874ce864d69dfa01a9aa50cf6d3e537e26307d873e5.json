  "query": "\n        SELECT e.feed_item_id as \"id!: i64\", e.embedding as \"embedding!: Vec<f32>\"\n        FROM feed_item_embeddings e\n        INNER JOIN feed_items f ON f.id = e.feed_item_id\n        WHERE e.model = $1\n          AND ($2::BIGINT IS NULL OR f.feed_id = $2)\n        ",
