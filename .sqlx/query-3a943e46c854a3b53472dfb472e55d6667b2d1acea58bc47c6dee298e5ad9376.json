{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.feed_id as \"feed_id!\",\n               SUM(e.embedding)::REAL[] as \"sum!\",\n               COUNT(*) as \"count!\"\n        FROM feed_item_embeddings e\n        INNER JOIN feed_items f ON f.id = e.feed_item_id\n        WHERE e.model = $1\n        GROUP BY f.feed_id, vector_dims(e.embedding)\n        ",
