{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.feed_item_id as \"id!: i64\",\n               f.feed_id as \"feed_id!: i64\",\n               e.embedding,\n               e.embedded_at\n        FROM feed_item_embeddings e\n        INNER JOIN feed_items f ON f.id = e.feed_item_id\n        WHERE e.model = $1\n          AND ($2::TIMESTAMPTZ IS NULL OR e.embedded_at > $2)\n        ",
